# ==============================================================================
# VidyaNiriksha AICTE Compliance Platform - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Core Application Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# Document Encryption Key (Fernet - 32 url-safe base64-encoded bytes)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOC_ENCRYPTION_KEY=your-fernet-encryption-key-here==

# Database Configuration
# Default SQLite: sqlite:///./backend/smartverify.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/smartverify
DATABASE_URL=sqlite:///./backend/smartverify.db

# Server & Network Configuration
PORT=5000
HOST=127.0.0.1
SESSION_COOKIE_SECURE=0

# Processing & Performance
# 1 = Background async worker thread, 0 = Synchronous processing
ASYNC_PROCESSING=1

# OCR & Vision Settings
OCR_LANGS=eng
# Minimum Laplacian variance threshold for sharpness (default 15.0)
SHARP_MIN=15.0

# Optional Experimental Image Tampering Analysis (ELA)
ENABLE_ELA=0

# Document Upload Limits
MAX_FILE_MB=10
